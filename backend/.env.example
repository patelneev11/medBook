# Copy this file to .env and fill in real values. Never commit .env to git.

# Database
# Use postgresql+asyncpg:// for the async driver (required)
DATABASE_URL=postgresql+asyncpg://mednotebook_user:your_password@localhost:5433/mednotebook_dev

# Auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS S3 — required for file uploads
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1

# AI — required for document Q&A
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60
